---
---

<div id="dynamic-bg" class="animated-background theme-night" transition:persist="background">
  <div class="css-wave wave-1"></div>
  <div class="css-wave wave-2"></div>
  <div class="css-wave wave-3"></div>
</div>

<script>
  function applyTimeTheme() {
    const bg = document.getElementById('dynamic-bg');
    if (!bg) return;
    
    const hour = new Date().getHours();
    let theme = 'theme-night';
    let isLightMode = false;

    if (hour >= 6 && hour < 8) {
      theme = 'theme-dawn';
      isLightMode = true;
    } else if (hour >= 8 && hour < 12) {
      theme = 'theme-morning';
      isLightMode = true;
    } else if (hour >= 12 && hour < 19) {
      theme = 'theme-noon';
      isLightMode = true;
    } else if (hour >= 19 && hour < 21) {
      theme = 'theme-sunset';
      isLightMode = true;
    } else if (hour >= 21 && hour < 22) {
      theme = 'theme-dusk';
      isLightMode = false;
    }

    // Remove existing themes
    bg.classList.remove('theme-dawn', 'theme-morning', 'theme-noon', 'theme-sunset', 'theme-dusk', 'theme-night');
    bg.classList.add(theme);

    // Toggle body light-mode
    if (isLightMode) {
      document.body.classList.add('light-mode');
    } else {
      document.body.classList.remove('light-mode');
    }
  }

  // Apply on initial load and navigation
  document.addEventListener('astro:page-load', applyTimeTheme);
  // Also apply immediately if the script runs before the event
  applyTimeTheme();
</script>

<style>
  .animated-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background-size: 4px 4px, 100% 100%;
    transition: background 1s ease-in-out;
  }

  /* GPU-Accelerated CSS Waves */
  .css-wave {
    position: absolute;
    width: 200%;
    height: 200%;
    top: -50%;
    left: -50%;
    border-radius: 40%;
    will-change: transform;
    opacity: 0.25;
    animation: rotate-wave linear infinite;
    transition: background 1s ease-in-out;
  }

  .wave-1 { animation-duration: 25s; top: 30%; left: -20%; }
  .wave-2 { animation-duration: 35s; top: 40%; left: 20%; }
  .wave-3 { animation-duration: 45s; top: 50%; left: -10%; }

  @keyframes rotate-wave {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Night Theme (Default/Base) */
  .theme-night {
    background: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(135deg, #010206 0%, #000000 100%);
  }
  .theme-night .wave-1 { background: linear-gradient(180deg, rgba(70,120,240,0.45) 0%, rgba(70,120,240,0) 100%); }
  .theme-night .wave-2 { background: linear-gradient(180deg, rgba(80,140,250,0.35) 0%, rgba(80,140,250,0) 100%); }
  .theme-night .wave-3 { background: linear-gradient(180deg, rgba(90,160,255,0.25) 0%, rgba(90,160,255,0) 100%); }

  /* Dawn Theme (06:00 - 07:59) */
  .theme-dawn {
    background: radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(135deg, #ffb7b2 0%, #e2b0ff 100%);
  }
  .theme-dawn .wave-1 { background: linear-gradient(180deg, rgba(255,183,178,0.2) 0%, rgba(255,183,178,0) 100%); }
  .theme-dawn .wave-2 { background: linear-gradient(180deg, rgba(226,176,255,0.15) 0%, rgba(226,176,255,0) 100%); }
  .theme-dawn .wave-3 { background: linear-gradient(180deg, rgba(178,216,255,0.1) 0%, rgba(178,216,255,0) 100%); }

  /* Morning Theme (08:00 - 11:59) */
  .theme-morning {
    background: radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
  }
  .theme-morning .wave-1 { background: linear-gradient(180deg, rgba(161,196,253,0.3) 0%, rgba(161,196,253,0) 100%); }
  .theme-morning .wave-2 { background: linear-gradient(180deg, rgba(194,233,251,0.2) 0%, rgba(194,233,251,0) 100%); }
  .theme-morning .wave-3 { background: linear-gradient(180deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 100%); }

  /* Noon Theme (12:00 - 18:59) */
  .theme-noon {
    background: radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  }
  .theme-noon .wave-1 { background: linear-gradient(180deg, rgba(79,172,254,0.3) 0%, rgba(79,172,254,0) 100%); }
  .theme-noon .wave-2 { background: linear-gradient(180deg, rgba(0,242,254,0.2) 0%, rgba(0,242,254,0) 100%); }
  .theme-noon .wave-3 { background: linear-gradient(180deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 100%); }

  /* Sunset Theme (19:00 - 20:59) */
  .theme-sunset {
    background: radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(135deg, #ff9966 0%, #ff5e62 100%);
  }
  .theme-sunset .wave-1 { background: linear-gradient(180deg, rgba(255,153,102,0.3) 0%, rgba(255,153,102,0) 100%); }
  .theme-sunset .wave-2 { background: linear-gradient(180deg, rgba(255,94,98,0.2) 0%, rgba(255,94,98,0) 100%); }
  .theme-sunset .wave-3 { background: linear-gradient(180deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 100%); }

  /* Dusk Theme (21:00 - 21:59) */
  .theme-dusk {
    background: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(135deg, #101525 0%, #1a1525 100%);
  }
  .theme-dusk .wave-1 { background: linear-gradient(180deg, rgba(100,140,200,0.4) 0%, rgba(100,140,200,0) 100%); }
  .theme-dusk .wave-2 { background: linear-gradient(180deg, rgba(120,110,180,0.35) 0%, rgba(120,110,180,0) 100%); }
  .theme-dusk .wave-3 { background: linear-gradient(180deg, rgba(140,120,220,0.25) 0%, rgba(140,120,220,0) 100%); }
</style>
