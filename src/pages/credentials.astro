---
import Layout from '../layouts/Layout.astro';
import Screen from '../components/Screen.astro';

const portfolioItems = [
  {
    image: "/web/certificates/google-cybersecurity-professional.png",
    alt: "Google Cybersecurity Professional Banner",
    title: "Google Cybersecurity Professional",
    badge: "Certification",
    issuer: "Google",
    description: "Professional certificate covering network security, Linux, Python, SQL, and incident response.",
    link: "https://www.coursera.org/professional-certificates/google-cybersecurity"
  },
  {
    image: "/web/certificates/fortinet-nse123.png",
    alt: "Fortinet NSE Banner",
    title: "Fortinet NSE 1, 2 and 3",
    badge: "Certification",
    issuer: "Fortinet",
    description: "Network Security Associate certifications focusing on the threat landscape and foundational network security concepts.",
    link: "https://www.fortinet.com/nse-training"
  },
  {
    image: "/web/certificates/integrals-penn.png",
    alt: "Calculus Integration Penn Banner",
    title: "Calculus: Single Variable Part 3 — Integration",
    badge: "Course",
    issuer: "University of Pennsylvania",
    description: "Integral calculus covering differential equations, techniques of integration, the Fundamental Theorem of Integral Calculus, and improper integrals.",
    link: "https://www.coursera.org/learn/integration-calculus"
  },
  {
    image: "/web/certificates/become-a-c-master.png",
    alt: "C Master Banner",
    title: "Become a C master (Programiz)",
    badge: "Course",
    issuer: "Programiz",
    description: "Comprehensive course on C programming, memory management, and fundamental computer science paradigms.",
    link: "https://www.programiz.com/c-programming"
  }
];

const types = [...new Set(portfolioItems.map(item => item.badge))];
const issuers = [...new Set(portfolioItems.map(item => item.issuer))];
---

<Layout title="Credentials" wide={true}>
  <Screen>
    <div class="banner">
      <h1>Credentials</h1>
    </div>
    <div class="page-content">
      <div class="search-filter-bar">
        <input type="text" id="credentialSearch" class="search-input" placeholder="Search credentials..." />
        <select id="typeFilter" class="filter-dropdown">
          <option value="all">All Types</option>
          {types.map(type => <option value={type.toLowerCase()}>{type}</option>)}
        </select>
        <select id="issuerFilter" class="filter-dropdown">
          <option value="all">All Issuers</option>
          {issuers.map(issuer => <option value={issuer.toLowerCase()}>{issuer}</option>)}
        </select>
      </div>

      <div class="gallery-grid" style="margin-bottom: 3rem;">
        {portfolioItems.map(item => (
          <div class="ui-card credential-card" data-title={item.title.toLowerCase()} data-type={item.badge.toLowerCase()} data-issuer={item.issuer.toLowerCase()} data-desc={item.description.toLowerCase()}>
            <img src={item.image} alt={item.alt} class="ui-card-banner" loading="lazy" />
            <h2>{item.title}</h2>
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.5rem;">
              <span class={`ui-badge badge-${item.badge.toLowerCase()}`}>{item.badge}</span>
              <span class="ui-badge" style="background: rgba(2, 132, 199, 0.1); color: #0369a1; border-color: rgba(2, 132, 199, 0.2);">Issued by {item.issuer}</span>
            </div>
            <p>{item.description}</p>
            <a href={item.link} class="ui-button" target="_blank" rel="noopener noreferrer">View Credential</a>
          </div>
        ))}
      </div>
    </div>
    <style>
      .badge-certification {
        background: rgba(16, 185, 129, 0.15) !important;
        color: #059669 !important;
        border-color: rgba(16, 185, 129, 0.3) !important;
      }
      .badge-course {
        background: rgba(99, 102, 241, 0.15) !important;
        color: #4f46e5 !important;
        border-color: rgba(99, 102, 241, 0.3) !important;
      }
      :global([data-theme="dark"]) .badge-certification {
        color: #6ee7b7 !important;
      }
      :global([data-theme="dark"]) .badge-course {
        color: #a5b4fc !important;
      }
      @media (prefers-color-scheme: dark) {
        .badge-certification {
          color: #6ee7b7 !important;
        }
        .badge-course {
          color: #a5b4fc !important;
        }
      }
    </style>
    <script>
      document.addEventListener('astro:page-load', () => {
        const searchInput = document.getElementById('credentialSearch') as HTMLInputElement;
        const typeFilter = document.getElementById('typeFilter') as HTMLSelectElement;
        const issuerFilter = document.getElementById('issuerFilter') as HTMLSelectElement;
        const cards = document.querySelectorAll('.credential-card');

        if (!searchInput || !typeFilter || !issuerFilter) return;

        function filterCards() {
          const query = searchInput.value.toLowerCase();
          const selectedType = typeFilter.value;
          const selectedIssuer = issuerFilter.value;

          cards.forEach(card => {
            const el = card as HTMLElement;
            const title = el.getAttribute('data-title') || '';
            const desc = el.getAttribute('data-desc') || '';
            const type = el.getAttribute('data-type') || '';
            const issuer = el.getAttribute('data-issuer') || '';

            const matchesSearch = title.includes(query) || desc.includes(query) || type.includes(query) || issuer.includes(query);
            const matchesType = selectedType === 'all' || type === selectedType;
            const matchesIssuer = selectedIssuer === 'all' || issuer === selectedIssuer;

            if (matchesSearch && matchesType && matchesIssuer) {
              el.style.display = '';
            } else {
              el.style.display = 'none';
            }
          });
        }

        searchInput.addEventListener('input', filterCards);
        typeFilter.addEventListener('change', filterCards);
        issuerFilter.addEventListener('change', filterCards);
      });
    </script>
  </Screen>
</Layout>
