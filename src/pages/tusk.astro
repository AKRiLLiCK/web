---
import Layout from '../layouts/Layout.astro';
import Screen from '../components/Screen.astro';
---

<Layout title="Tusk" wide={true}>
  <Screen>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" integrity="sha384-GvrOXuhMATgEsSwCs4smul74iXGOixntILdUW9XmUC6+HX0sLNAK3q71bZBTIQHQ" crossorigin="anonymous">
    <script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js" integrity="sha384-cpW21h6RZv/phavutF+GqIGc/9O29yWeQ8j82NenH0R1YdK3XlT3J6+zB38fJ/u" crossorigin="anonymous"></script>

    <div class="wa-container">
      <header class="wa-header">
        <div class="wa-logo">
          <span class="wa-logo-tusk">Tusk</span>
          <span class="wa-logo-sub">symbolic computation engine</span>
        </div>
        <div class="wa-search-wrapper">
          <div class="wa-search-bar">
            <input type="text" id="waInput" placeholder="e.g., int(x * sin(x), x)" autocomplete="off" spellcheck="false" />
            <button id="waSubmit">=</button>
          </div>
        </div>
      </header>

      <div class="wa-content">
        <div class="wa-pod" id="pod-input" style="display: none;">
          <h2 class="wa-pod-title">Input interpretation</h2>
          <div class="wa-pod-content" id="wa-input-render"></div>
        </div>

        <div class="wa-pod" id="pod-result" style="display: none;">
          <h2 class="wa-pod-title">Result</h2>
          <div class="wa-pod-content wa-result-content" id="wa-result-render"></div>
        </div>

        <div class="wa-pod" id="pod-steps" style="display: none;">
          <h2 class="wa-pod-title">Step-by-step solution</h2>
          <div class="wa-pod-content wa-steps-content" id="wa-steps-render"></div>
        </div>

        <div class="wa-pod" id="pod-error" style="display: none;">
           <h2 class="wa-pod-title">Error</h2>
           <div class="wa-pod-content" id="wa-error-render" style="color: #ff6b6b;">Tusk could not parse the input.</div>
        </div>
      </div>
    </div>

    <script is:inline>
      // Core logic encapsulated
      function runEnginePipeline() {
        const input = document.getElementById('waInput');
        const renderInput = document.getElementById('wa-input-render');
        const renderSteps = document.getElementById('wa-steps-render');
        const renderResult = document.getElementById('wa-result-render');
        
        const podInput = document.getElementById('pod-input');
        const podSteps = document.getElementById('pod-steps');
        const podResult = document.getElementById('pod-result');
        const podError = document.getElementById('pod-error');

        const val = input ? input.value.trim() : "";
        if (!val) return;

        // Reset UI
        [podInput, podSteps, podResult, podError].forEach(p => p.style.display = 'none');

        const expr = tryParse(val);
        if (!expr) {
          podError.style.display = 'block';
          return;
        }

        // Render interpretation
        podInput.style.display = 'block';
        katex.render(exprToLatex(expr), renderInput, { displayMode: true });

        // Engine logic (Simplified simulation)
        const steps = [];
        let current = expr;
        // In a real implementation, call your Rust-based heuristics here
        
        podResult.style.display = 'block';
        katex.render(exprToLatex(current), renderResult, { displayMode: true });
      }

      // Re-bind listeners for Astro page transitions
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('waSubmit');
        const inp = document.getElementById('waInput');
        if (btn) btn.onclick = runEnginePipeline;
        if (inp) inp.onkeydown = (e) => { if (e.key === 'Enter') runEnginePipeline(); };
      });
      
      // Paste your parser/engine functions (tokenize, parseExpr, simplify, heuristic, exprToLatex) here.
    </script>

    <style>
      .wa-container { color: #eee; min-height: 80vh; padding: 2rem 0; }
      .wa-header { text-align: center; margin-bottom: 2rem; }
      .wa-logo-tusk { font-size: 2.5rem; font-weight: 800; color: #fff; }
      .wa-logo-sub { display: block; color: #888; font-size: 0.8rem; }
      .wa-search-bar { display: flex; max-width: 600px; margin: 1rem auto; background: #000; border-radius: 8px; border: 1px solid #333; }
      .wa-search-bar input { flex: 1; padding: 1rem; background: transparent; border: none; color: #fff; outline: none; }
      .wa-search-bar button { background: #333; color: #fff; border: none; padding: 0 1.5rem; cursor: pointer; }
      .wa-pod { background: #1a1a1a; border: 1px solid #333; border-radius: 8px; margin: 1rem auto; max-width: 800px; }
      .wa-pod-title { font-size: 0.9rem; padding: 0.5rem 1rem; border-bottom: 1px solid #333; color: #aaa; }
    </style>
  </Screen>
</Layout>