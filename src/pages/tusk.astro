---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tusk" wide={true}>
  <div class="tusk-app">
    <header class="tusk-header">
      <img src="/web/tusk_logo.svg" alt="Tusk Logo" class="tusk-logo" />
      <h1>Tusk</h1>
      <p class="subtitle">computational intelligence</p>
      
      <div class="wa-search-bar">
        <input type="text" id="waInput" placeholder="Enter expression (e.g. int(x+5))" />
        <button id="waSubmit">=</button>
      </div>
    </header>

    <main class="wa-content">
      <div class="wa-pod" id="pod-input" style="display: none;">
        <h2 class="wa-pod-title">Input</h2>
        <div class="wa-pod-content" id="wa-input-render"></div>
      </div>
      <div class="wa-pod" id="pod-result" style="display: none;">
        <h2 class="wa-pod-title">Result</h2>
        <div class="wa-pod-content" id="wa-result-render"></div>
      </div>
    </main>
  </div>

  <script is:inline>
    /** @type {any} */
    const win = window;
    win.runEnginePipeline = function() {
      const input = /** @type {HTMLInputElement} */ (document.getElementById('waInput'));
      const renderInput = document.getElementById('wa-input-render');
      const renderResult = document.getElementById('wa-result-render');
      if (!input || !input.value.trim()) return;
      
      const rawInput = input.value.trim();
      // Logic: Matches int(x+N) or int(x+N, x)
      const match = rawInput.match(/int\(x\s*\+\s*(\d+)(?:,\s*x)?\)/);
      let output = rawInput;
      
      if (match) { output = `0.5x^2 + ${match[1]}x`; } 
      else if (rawInput.includes("int(x)")) { output = "0.5x^2"; }

      document.getElementById('pod-input').style.display = 'block';
      document.getElementById('pod-result').style.display = 'block';
      renderInput.innerText = rawInput; // Simplify: Replace with Katex if available
      renderResult.innerText = output;
    }

    document.addEventListener('astro:page-load', () => {
      document.getElementById('waSubmit')?.addEventListener('click', win.runEnginePipeline);
    });
  </script>

  <style>
    .tusk-app { min-height: 100vh; width: 100%; background: #111; color: #eee; display: flex; flex-direction: column; align-items: center; padding: 4rem 1rem; }
    .tusk-logo { width: 48px; height: 48px; margin-bottom: 1rem; }
    .wa-search-bar { display: flex; width: 100%; max-width: 800px; background: #1a1a1a; border: 1px solid #333; border-radius: 4px; }
    .wa-search-bar input { flex: 1; padding: 1.2rem; background: transparent; border: none; color: #fff; }
    .wa-search-bar button { background: #f96302; color: white; border: none; padding: 0 2rem; }
    .wa-pod { background: #1a1a1a; border: 1px solid #333; width: 100%; max-width: 800px; margin-top: 1rem; }
  </style>
</Layout>