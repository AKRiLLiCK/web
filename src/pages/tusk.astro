---
import Layout from '../layouts/Layout.astro';
import Screen from '../components/Screen.astro';
---

<Layout title="Tusk" wide={true}>
  <Screen>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" integrity="sha384-GvrOXuhMATgEsSwCs4smul74iXGOixntILdUW9XmUC6+HX0sLNAK3q71bZBTIQHQ" crossorigin="anonymous">
    <script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js" integrity="sha384-cpW21h6RZv/phavutF+GqIGc/9O29yWeQ8j82NenH0R1YdK3XlT3J6+zB38fJ/u" crossorigin="anonymous"></script>

    <div class="wa-container">
      <header class="banner">
        <h1>Tusk</h1>
        <span class="wa-logo-sub">computational intelligence</span>
        
        <div class="wa-search-wrapper">
          <div class="wa-search-bar">
            <input type="text" id="waInput" placeholder="Enter expression (e.g., int(x * sin(x), x))" autocomplete="off" spellcheck="false" />
            <button id="waSubmit">=</button>
          </div>
        </div>
      </header>

      <div class="wa-content">
        <div class="wa-pod" id="pod-input" style="display: none;">
          <h2 class="wa-pod-title">Input interpretation</h2>
          <div class="wa-pod-content" id="wa-input-render"></div>
        </div>

        <div class="wa-pod" id="pod-result" style="display: none;">
          <h2 class="wa-pod-title">Result</h2>
          <div class="wa-pod-content wa-result-content" id="wa-result-render"></div>
        </div>

        <div class="wa-pod" id="pod-steps" style="display: none;">
          <h2 class="wa-pod-title">Step-by-step solution</h2>
          <div class="wa-pod-content wa-steps-content" id="wa-steps-render"></div>
        </div>

        <div class="wa-pod" id="pod-error" style="display: none;">
           <h2 class="wa-pod-title">Error</h2>
           <div class="wa-pod-content" id="wa-error-render" style="color: #ff6b6b;">Tusk could not parse the input. Check your syntax.</div>
        </div>
      </div>
    </div>

    <script is:inline>
      // Global engine functions move out of the event listener
      function tokenize(s) { /* Implementation */ }
      function parseExpr(tokens, pos) { /* Implementation */ }
      function tryParse(s) { /* Implementation */ }
      function exprToLatex(e) { /* Implementation */ }
      function simplify(e) { /* Implementation */ }
      function heuristic(e) { /* Implementation */ }

      function runEnginePipeline() {
        const input = document.getElementById('waInput');
        const renderInput = document.getElementById('wa-input-render');
        const renderSteps = document.getElementById('wa-steps-render');
        const renderResult = document.getElementById('wa-result-render');
        
        if (!input || !renderInput) return;

        const val = input.value.trim();
        if (!val) return;

        // Reset display
        ['pod-input', 'pod-steps', 'pod-result', 'pod-error'].forEach(id => {
          document.getElementById(id).style.display = 'none';
        });

        const expr = tryParse(val);
        if (!expr) {
          document.getElementById('pod-error').style.display = 'block';
          return;
        }

        document.getElementById('pod-input').style.display = 'block';
        katex.render(exprToLatex(expr), renderInput, { displayMode: true });

        // Calculate steps
        const steps = [];
        let current = expr;
        for (let i = 0; i < 20; i++) {
          const s = simplify(current);
          if (s) { steps.push({ desc: 'Simplification', expr: s }); current = s; continue; }
          const h = heuristic(current);
          if (h) { steps.push({ desc: h.desc, expr: h.expr }); current = h.expr; continue; }
          break;
        }

        document.getElementById('pod-result').style.display = 'block';
        katex.render(exprToLatex(current), renderResult, { displayMode: true });

        if (steps.length > 0) {
          document.getElementById('pod-steps').style.display = 'block';
          renderSteps.innerHTML = steps.map((s, i) => `
            <div class="wa-step-item">
              <div class="wa-step-desc">${i+1}. ${s.desc}</div>
              <div class="wa-step-math" id="step-${i}"></div>
            </div>`).join('');
          steps.forEach((s, i) => katex.render(exprToLatex(s.expr), document.getElementById('step-' + i), { displayMode: true }));
        }
      }

      // Re-bind listeners for Astro page transitions
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('waSubmit');
        const inp = document.getElementById('waInput');
        if (btn) btn.addEventListener('click', runEnginePipeline);
        if (inp) inp.addEventListener('keydown', (e) => { if (e.key === 'Enter') runEnginePipeline(); });
      });
    </script>
  </Screen>
</Layout>