---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Screen from '../../components/Screen.astro';

export async function getStaticPaths() {
  const archiveEntries = await getCollection('archive');
  return archiveEntries.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, author, publishDate, docType, downloadUrl, coverImage, isbn } = entry.data;

const formattedDate = publishDate.toISOString().split('T')[0];
---

<Layout title={title} wide={true}>
  <Screen>
    <div class="banner">
      <h1>Archive</h1>
    </div>
    <div class="page-content preview-content">
      
      <div class="split-view">
        <div class="cover-column">
          <div class="cover-container">
            <Image 
              src={coverImage} 
              alt={`Cover of ${title}`} 
              width={600} 
              height={840} 
              densities={[1.5, 2]}
              class="detail-cover" 
            />
          </div>
        </div>
        
        <div class="metadata-column">
          <h2 class="detail-title">{title}</h2>
          <div class="metadata-table">
            <div class="meta-row">
              <span class="meta-label">Author</span>
              <span class="meta-value">{author}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">Published</span>
              <span class="meta-value">{formattedDate}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">Type</span>
              <span class="meta-value">
                <span class={`tag tag-${docType.toLowerCase()}`}>{docType}</span>
              </span>
            </div>
            {isbn && (
              <div class="meta-row">
                <span class="meta-label">ISBN</span>
                <span class="meta-value">{isbn}</span>
              </div>
            )}
          </div>
          <div class="download-section">
            <a href={downloadUrl || '#'} class="squircle-btn download-btn">
              Access
            </a>
          </div>
        </div>
      </div>
      
      <hr class="separator" />

      <div class="markdown-body">
        <Content />
      </div>
    </div>

    <style>
      .preview-content {
        display: flex;
        flex-direction: column;
      }
      
      .split-view {
        display: grid;
        grid-template-columns: minmax(180px, 1fr) 2fr;
        gap: 2rem;
        margin-bottom: 1.5rem;
      }

      @media (max-width: 600px) {
        .split-view {
          grid-template-columns: 1fr;
        }
      }

      .cover-container {
        border-radius: 3px 8px 8px 3px;
        background: #000;
        box-shadow: -4px 0px 0px #333, -6px 6px 15px rgba(0,0,0,0.9);
        overflow: hidden;
        position: relative;
      }
      
      .cover-container::before {
        content: '';
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 5px;
        background: linear-gradient(to right, rgba(255,255,255,0.5), rgba(255,255,255,0));
        z-index: 2;
        border-radius: 3px 0 0 3px;
      }

      .detail-cover {
        width: 100%;
        height: auto;
        display: block;
      }

      .metadata-column {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
      }

      .detail-title {
        font-size: 1.6rem;
        color: var(--text-main);
        margin-bottom: 1rem;
        line-height: 1.2;
        border-bottom: 2px solid rgba(255,255,255,0.1);
        padding-bottom: 0.5rem;
      }

      .metadata-table {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 16px;
        padding: 1rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.2);
      }

      .meta-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px dashed rgba(255,255,255,0.2);
        padding-bottom: 0.4rem;
      }

      .meta-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      .meta-label {
        color: #999;
        font-size: 0.85rem;
        text-transform: uppercase;
        font-weight: bold;
        letter-spacing: 1px;
      }

      .meta-value {
        color: var(--text-main);
        font-size: 0.95rem;
        text-align: right;
      }

      .separator {
        border-color: rgba(255,255,255,0.1);
        margin: 2rem 0;
      }

      .tag {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.85rem;
        font-family: sans-serif;
        font-weight: bold;
        border: none;
        box-shadow: inset 0 2px 4px rgba(255,255,255,0.3), 0 2px 5px rgba(0,0,0,0.5);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .tag-book { color: #000; background: linear-gradient(180deg, #bae1ff 0%, #7dbdec 100%); }
      .tag-paper { color: #000; background: linear-gradient(180deg, #ffffba 0%, #dede70 100%); }
      .tag-essay { color: #000; background: linear-gradient(180deg, #baffc9 0%, #72d48a 100%); }
      .tag-manual { color: #000; background: linear-gradient(180deg, #ffdfba 0%, #eaab65 100%); }
      .tag-devlog { color: #000; background: linear-gradient(180deg, #e0b0ff 0%, #b268e3 100%); }

      .markdown-body {
        color: var(--text-muted);
        line-height: 1.7;
        font-size: 0.95rem;
        flex-grow: 1;
      }
      
      .markdown-body p {
        margin-bottom: 1.2rem;
      }

      .download-section {
        margin-top: 1.5rem;
        display: flex;
        justify-content: flex-end;
      }

      .squircle-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 28px;
        background: linear-gradient(180deg, #444 0%, #222 100%);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 50px;
        box-shadow: inset 0 1px 2px rgba(255,255,255,0.1), 0 4px 10px rgba(0,0,0,0.5);
        color: var(--text-main);
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.95rem;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
      }

      .squircle-btn:active {
        box-shadow: inset 0 4px 8px rgba(0,0,0,0.8);
        background: linear-gradient(180deg, #222 0%, #111 100%);
        transform: translateY(2px);
      }

      /* Light Mode Overrides */
      :global(body.light-mode) .metadata-table {
        background: rgba(255, 255, 255, 0.4);
        border-color: rgba(255,255,255,0.6);
        box-shadow: 0 4px 15px rgba(0,0,0,0.05), inset 0 1px 0 rgba(255,255,255,0.8);
      }
      :global(body.light-mode) .meta-row {
        border-bottom-color: rgba(0,0,0,0.1);
      }
      :global(body.light-mode) .meta-label {
        color: #555;
      }
      :global(body.light-mode) .squircle-btn {
        background: linear-gradient(180deg, #fdfdfd 0%, #dcdcdc 100%);
        border-color: rgba(0,0,0,0.1);
        box-shadow: inset 0 1px 2px rgba(255,255,255,0.6), 0 4px 6px rgba(0,0,0,0.1);
        color: #111;
      }
      :global(body.light-mode) .squircle-btn:active {
        background: linear-gradient(180deg, #dcdcdc 0%, #ececec 100%);
        box-shadow: inset 0 4px 8px rgba(0,0,0,0.1);
      }
      :global(body.light-mode) .detail-title {
        border-bottom-color: rgba(0,0,0,0.1);
      }
      :global(body.light-mode) .cover-container {
        box-shadow: -4px 0px 0px #eee, -6px 6px 15px rgba(0,0,0,0.2);
      }
    </style>
  </Screen>
</Layout>
