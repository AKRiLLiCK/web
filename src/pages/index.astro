---
import Layout from "../layouts/Layout.astro";
import Screen from "../components/Screen.astro";

const techStack = [
    // Languages
    { name: "Rust", icon: "rust" },
    { name: "C", icon: "c" },
    { name: "Dlang", icon: "d" },
    { name: "Java", icon: "java" },
    { name: "Python", icon: "python" },
    { name: "Bash", icon: "bash" },
    { name: "PowerShell", icon: "powershell" },
    { name: "WebAssembly", icon: "wasm" },
    { name: "HTML", icon: "html" },
    { name: "CSS", icon: "css" },
    
    // Operating Systems
    { name: "Linux", icon: "linux" },
    { name: "Arch Linux", icon: "arch" },
    { name: "Debian", icon: "debian" },
    { name: "Kali Linux", icon: "kali" },
    { name: "NixOS", icon: "nix" },
    { name: "Windows", icon: "windows" },
    
    // Frameworks & Tools
    { name: "Astro", icon: "astro" },
    { name: "Arduino", icon: "arduino" },
    { name: "Godot", icon: "godot" },
    { name: "Docker", icon: "docker" },
    { name: "Git", icon: "git" },
    { name: "GitHub", icon: "github" },
    
    // Applications & Editors
    { name: "VSCode", icon: "vscode" },
    { name: "NeoVim", icon: "neovim" },
    { name: "IntelliJ IDEA", icon: "idea" },
    { name: "Obsidian", icon: "obsidian" },
    { name: "Discord", icon: "discord" },
];

const totalSlots = 36; // 6 rows of 6
---

<Layout title="Home">
    <Screen>
        <div class="banner">
            <h1>ACRILIC</h1>
        </div>
        <div class="page-content">
            <div style="text-align: center; margin-bottom: 2rem;">
                <a
                    href="https://en.pronouns.page/@Acrilic"
                    target="_blank"
                    class="pastel-card"
                    style="text-align: left; margin: 0 auto 1.5rem auto; max-width: 600px;"
                >
                    <h2>
                        <img
                            src="https://en.pronouns.page/favicon.ico"
                            width="24"
                            height="24"
                            alt="Pronouns.page"
                            style="border-radius: 4px;"
                        />
                        Acrilic
                    </h2>
                    <div style="margin-bottom: 0.8rem;">
                        <span class="pastel-badge pink">He/Him</span>
                        <span class="pastel-badge blue">🇪🇸 ES (Native)</span>
                        <span class="pastel-badge green">🇬🇧 EN (C1)</span>
                    </div>
                    <p>
                        <strong>Computer Engineering Student</strong>, founder
                        of Yutila, <strong>polymath</strong>, and
                        multidisciplinary creator — exploring the full depth of
                        the computing spectrum.
                    </p>
                </a>

                <div style="margin-top: 1rem;">
                    <a
                        href="https://youtube.com/@AKRiLLiCK"
                        class="software-badge"
                    >
                        <img
                            src="https://img.shields.io/badge/YouTube-FF0000?style=for-the-badge&logo=youtube&logoColor=white"
                            alt="YouTube"
                            width="106"
                            height="28"
                        />
                    </a>
                    <a href="https://ko-fi.com/acrilic" class="software-badge">
                        <img
                            src="https://img.shields.io/badge/Ko--fi-F16061?style=for-the-badge&logo=ko-fi&logoColor=white"
                            alt="Ko-Fi"
                            width="82"
                            height="28"
                        />
                    </a>
                    <a
                        href="https://orcid.org/0009-0003-6052-2564"
                        class="software-badge"
                    >
                        <img
                            src="https://img.shields.io/badge/ORCID-A6CE39?style=for-the-badge&logo=orcid&logoColor=white"
                            alt="ORCID"
                            width="87"
                            height="28"
                        />
                    </a>
                </div>
            </div>

            <hr />

            <div class="identity-section">
                <h2 style="display: flex; align-items: center; gap: 0.5rem;">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"
                        ></path><circle cx="12" cy="7" r="4"></circle></svg
                    > About Me
                </h2>
                <p>
                    I am Acrilic, a first-year Computer Engineering student at the <a href="https://www.upm.es/" target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: none;">Technical University of Madrid</a>. I maintain a strictly faceless persona to focus on technical craft, ideas and engineering reality. I operate across the entire computing spectrum spanning hardware, software, high-level abstractions and low-level architecture.
                </p>

                <h3 style="margin-top: 1.5rem; font-size: 1.2rem;">Engineering Profile</h3>
                <ul style="padding-left: 1.5rem;">
                    <li style="margin-bottom: 0.5rem;"><strong>Systems Programming:</strong> Rust and C. Architectural focus targets ownership, zero-cost abstractions, minimal allocation and explicit error handling.</li>
                    <li style="margin-bottom: 0.5rem;"><strong>Security Posture:</strong> Ethical hacking, red teaming, blue teaming, purple teaming and digital forensics.</li>
                    <li style="margin-bottom: 0.5rem;"><strong>Hardware Design:</strong> Core logic architecture modeled via Logisim Evolution.</li>
                    <li><strong>Environments:</strong> Arch-based Linux (EndeavourOS), Debian and WSL.</li>
                </ul>

                <h3 style="margin-top: 1.5rem; font-size: 1.2rem;">Multidisciplinary Production</h3>
                <p>Beyond engineering, I execute across several creative and analytical domains:</p>
                <ul style="padding-left: 1.5rem;">
                    <li style="margin-bottom: 0.5rem;"><strong>Writing:</strong> Authors philosophical essays, technical documentation and narrative fiction.</li>
                    <li style="margin-bottom: 0.5rem;"><strong>Media & Content:</strong> Produces educational engineering media.</li>
                    <li style="margin-bottom: 0.5rem;"><strong>Design:</strong> Structures UI/UX interfaces for ergonomics and applies typography for aesthetic density.</li>
                    <li style="margin-bottom: 0.5rem;"><strong>Narrative & Worldbuilding:</strong> Constructs story frameworks and conceptualizes characters.</li>
                    <li><strong>Archival:</strong> Curates physical literature and technical manual collections.</li>
                </ul>

                <h3 style="margin-top: 1.5rem; font-size: 1.2rem;">Operations and Assets</h3>
                <p>
                    I have an organization called <strong><a href="https://yutila.com" target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: none;">Yutila</a></strong>, which is an independent community of developers crafting open-source software, interactive media and hardware. We focus on building applications, games and tools centered on privacy, security and digital freedom.
                </p>
            </div>


            <details class="ds-toggle">
                <summary
                    ><svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        ><path
                            d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"
                        ></path></svg
                    > My Archive</summary
                >
                <div class="ds-toggle-content">
                    <p>
                        Beyond software and hardware, I maintain an open-access
                        library of technical documentation, philosophical
                        essays, and research papers under the <strong
                            >Open To All (OTA)</strong
                        > public license.
                    </p>
                    <div style="text-align: center; margin-top: 1.5rem;">
                        <a
                            href="/web/archive"
                            class="ui-button"
                            style="padding: 0.75rem 1.5rem; font-size: 1.1rem;"
                            >Access the Arcadia Archive</a
                        >
                    </div>
                </div>
            </details>

            <details class="ds-toggle">
                <summary
                    ><svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"
                        ></path><circle cx="9" cy="7" r="4"></circle><path
                            d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path
                            d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
                    > Network</summary
                >
                <div class="ds-toggle-content">
                    <p>A collection of interesting nodes in my network.</p>
                    <ul style="list-style-type: none; padding-left: 0;">
                        <li
                            style="margin-bottom: 0.8rem; display: flex; align-items: center; gap: 0.8rem;"
                        >
                            <img
                                src="/web/friends/spider-kyle.png"
                                alt="Friend 1"
                                style="width: 32px; height: 32px; border-radius: 50%; border: 1px solid #444; object-fit: cover; background: #222;"
                                onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 24 24%27 fill=%27none%27 stroke=%27%23666%27 stroke-width=%272%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27%3E%3Cpath d=%27M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2%27%3E%3C/path%3E%3Ccircle cx=%2712%27 cy=%277%27 r=%274%27%3E%3C/circle%3E%3C/svg%3E'"
                            />
                            <div>
                                <a
                                    href="https://spider-kyle.neocities.org/"
                                    style="font-weight: bold; color: var(--text-main);"
                                    >Spider-Kyle</a
                                > -
                                <span style="color: var(--text-muted);"
                                    >Student, software engineer and gamedev</span
                                >
                            </div>
                        </li>
                    </ul>
                </div>
            </details>

            <hr />

            <div
                style="text-align: center; margin-top: 2rem; overflow-x: auto; scroll-behavior: smooth; -webkit-overflow-scrolling: touch;"
            >
                <h2
                    style="font-size: 1.2rem; margin-bottom: 1rem; border: none;"
                >
                    Tech Stack
                </h2>
                <div
                    class="home-menu-grid"
                    style="max-width: 600px; margin: 0 auto;"
                >
                    {
                        Array.from({ length: totalSlots }).map((_, i) => {
                            const tech = techStack[i];
                            return tech ? (
                                <div class="home-menu-slot" title={tech.name}>
                                    <div class="software-badge">
                                        <img
                                            src={tech.icon === 'd' ? '/web/dlang-skillicon.svg' : `https://skillicons.dev/icons?i=${tech.icon}`}
                                            width="48"
                                            height="48"
                                            alt={tech.name}
                                            loading="lazy"
                                        />
                                    </div>
                                </div>
                            ) : (
                                <div class="home-menu-slot">
                                    <div class="empty-slot" />
                                </div>
                            );
                        })
                    }
                </div>
            </div>
        </div>
    </Screen>
</Layout>
