---
import Layout from '../layouts/Layout.astro';
import Screen from '../components/Screen.astro';

const basePath = import.meta.env.BASE_URL;

const portfolioItems = [
  {
    image: `${basePath}projects/camelot-banner.png`,
    alt: "Camelot Banner",
    title: "Camelot",
    type: "Framework",
    badges: ["C", "Framework"],
    description: "An enterprise-grade C framework prioritizing long-term reliability, cross-platform interoperability and transaction stability for mission-critical environments.",
    link: "https://github.com/yutila-org/camelot"
  },
  {
    image: `${basePath}projects/tusk-banner.svg`,
    alt: "Tusk Banner",
    title: "Tusk",
    type: "Tool",
    badges: ["Rust", "WASM", "Astro", "TypeScript", "Math"],
    description: "A high-performance Rust computing engine with a TUI and Web Interface. Supports symbolic manipulation, custom functions and numerical evaluation.",
    link: `https://akrillick.github.io/tusk`
  }
];

const types = [...new Set(portfolioItems.map(item => item.type))];
---

<Layout title="Projects" wide={true}>
  <Screen>
    <div class="banner">
      <h1>Projects</h1>
    </div>
    <div class="page-content">

      <div class="search-filter-bar">
        <input type="text" id="projectSearch" class="search-input" placeholder="Search projects by name, badge, or keyword..." />
      </div>

      <noscript>
        <div style="color: #ffb3ba; font-size: 0.85rem; padding: 0.5rem; border: 1px dashed #ffb3ba; border-radius: 4px; text-align: center; margin-bottom: 1rem;">
          JavaScript is disabled. Displaying all projects below.
        </div>
      </noscript>

      {portfolioItems.length > 0 ? (
        <div class="gallery-grid">
          {portfolioItems.map(item => (
            <div class="ui-card project-card" data-title={item.title.toLowerCase()} data-type={item.type.toLowerCase()} data-badges={item.badges.join(' ').toLowerCase()} data-desc={item.description.toLowerCase()}>
              <img src={item.image} alt={item.alt} class="ui-card-banner" />
              <h2>{item.title}</h2>
              {item.badges.map(b => <span class="ui-badge" style="margin-right: 4px;">{b}</span>)}
              <p>{item.description}</p>
              <a href={item.link} target="_blank" class="ui-button">View Repository</a>
            </div>
          ))}
        </div>
      ) : (
        <p style="text-align: center; color: #888; font-style: italic;">No projects listed yet.</p>
      )}
    </div>
    
    <script>
      document.addEventListener('astro:page-load', () => {
        const searchInput = document.getElementById('projectSearch') as HTMLInputElement;
        const projectCards = document.querySelectorAll('.project-card');

        if (!searchInput) return;

        function filterCards() {
          const query = searchInput.value.toLowerCase();

          projectCards.forEach(card => {
            const el = card as HTMLElement;
            const title = el.getAttribute('data-title') || '';
            const badges = el.getAttribute('data-badges') || '';
            const desc = el.getAttribute('data-desc') || '';

            const matchesSearch = title.includes(query) || badges.includes(query) || desc.includes(query);

            if (matchesSearch) {
              el.style.display = '';
            } else {
              el.style.display = 'none';
            }
          });
        }

        searchInput.addEventListener('input', filterCards);
      });
    </script>
    <style>
      noscript + .gallery-grid {
        display: grid !important;
      }
      noscript ~ .search-filter-bar {
        display: none !important;
      }
    </style>
  </Screen>
</Layout>
