---
import Layout from './Layout.astro';
import Screen from '../components/Screen.astro';
import { Image } from 'astro:assets';

const { frontmatter, title: propTitle, description: propDescription, date: propDate, tags: propTags, bannerImage: propBannerImage } = Astro.props;

const title = frontmatter?.title || propTitle;
const description = frontmatter?.description || propDescription;
const date = frontmatter?.date || propDate;
const tags = frontmatter?.tags || propTags || [];
const bannerImage = frontmatter?.bannerImage || propBannerImage;

const basePath = import.meta.env.BASE_URL;
---

<Layout title={title} activeWindow="Arcadia Academy" wide={true}>
  <Screen>
    <div class="mocha-course-container">
      <div class="banner">
        <h1>Arcadia Academy</h1>
      </div>
      <div class="page-content">
        {bannerImage && (
          <div class="course-banner-container">
            <Image 
              src={bannerImage} 
              alt={`Banner for ${title}`} 
              width={1200} 
              height={675}
              class="course-banner-img"
            />
          </div>
        )}

        <div class="progress-bar-container">
          <div class="progress-bar-header">
            <span class="progress-label">Course Audit Progress</span>
            <span class="progress-percent" id="progress-percent">0% Complete</span>
          </div>
          <div class="progress-track">
            <div class="progress-fill" id="progress-fill"></div>
          </div>
        </div>

        <div class="course-header">
          <h2 class="course-title">{title}</h2>
          <p class="course-desc">{description}</p>
          <div class="course-meta">
            <span class="course-date">{date ? new Date(date).toISOString().split('T')[0] : ''}</span>
            <div class="course-tags">
              {tags.map((tag: string) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </div>
        <hr class="separator" />
        <div class="markdown-body">
          <slot />
        </div>
        <footer class="course-footer">
          <p class="license-notice">
            This course complies with the <a href={`${basePath}OTA.md`} target="_blank" rel="noopener noreferrer">OTA (Open To All)</a> public license.
            Copyleft 🄯 {new Date().getFullYear()}.
          </p>
        </footer>
      </div>
    </div>
  </Screen>
</Layout>

<script>
  function initInteractiveTasks() {
    const lists = document.querySelectorAll('.markdown-body ol');
    if (lists.length === 0) return;

    let totalTasks = 0;
    const taskStates = JSON.parse(localStorage.getItem('course_progress_electronegativity') || '{}');

    lists.forEach((list, listIndex) => {
      const items = list.querySelectorAll('li');
      items.forEach((item, itemIndex) => {
        if (item.querySelector('.task-checkbox')) return;
        
        totalTasks++;
        const taskId = `task-${listIndex}-${itemIndex}`;
        
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.className = 'task-checkbox';
        checkbox.id = taskId;
        checkbox.checked = !!taskStates[taskId];

        if (checkbox.checked) {
          item.classList.add('task-completed');
        }

        checkbox.addEventListener('change', (e: Event) => {
          const target = e.target as HTMLInputElement;
          const isChecked = target.checked;
          taskStates[taskId] = isChecked;
          localStorage.setItem('course_progress_electronegativity', JSON.stringify(taskStates));
          
          if (isChecked) {
            item.classList.add('task-completed');
          } else {
            item.classList.remove('task-completed');
          }
          
          updateProgressBar();
        });

        const textWrapper = document.createElement('span');
        textWrapper.className = 'task-text';
        while (item.firstChild) {
          textWrapper.appendChild(item.firstChild);
        }

        item.appendChild(checkbox);
        item.appendChild(textWrapper);
      });
    });

    function updateProgressBar() {
      let checkedCount = 0;
      const checkboxes = document.querySelectorAll('.task-checkbox');
      checkboxes.forEach(cb => {
        if ((cb as HTMLInputElement).checked) checkedCount++;
      });
      
      const total = checkboxes.length;
      const percent = total > 0 ? Math.round((checkedCount / total) * 100) : 0;
      const fill = document.getElementById('progress-fill');
      const percentText = document.getElementById('progress-percent');
      
      if (fill) fill.style.width = `${percent}%`;
      if (percentText) percentText.textContent = `${percent}% Complete`;
    }

    updateProgressBar();
  }

  document.addEventListener('DOMContentLoaded', initInteractiveTasks);
  document.addEventListener('astro:page-load', initInteractiveTasks);
</script>

<style is:global>
  :root {
    --ctp-base: #1e1e2e;
    --ctp-mantle: #181825;
    --ctp-crust: #11111b;
    --ctp-text: #cdd6f4;
    --ctp-subtext1: #bac2de;
    --ctp-subtext0: #a6adc8;
    --ctp-surface0: #313244;
    --ctp-surface1: #45475a;
    --ctp-surface2: #585b70;
    --ctp-mauve: #cba6f7;
    --ctp-blue: #89b4fa;
    --ctp-lavender: #b4befe;
    --ctp-green: #a6e3a1;
    --ctp-pink: #f5c2e7;
  }

  :global(.screen-inset:has(.mocha-course-container)) {
    background-color: var(--ctp-base) !important;
    border-color: var(--ctp-surface0) !important;
    box-shadow: inset 0 0 30px rgba(17, 17, 27, 0.9) !important;
    position: relative !important;
    overflow: hidden !important;
  }

  .mocha-course-container {
    position: absolute !important;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
  }

  .mocha-course-container::-webkit-scrollbar {
    width: 6px;
  }
  .mocha-course-container::-webkit-scrollbar-track {
    background: var(--ctp-crust);
  }
  .mocha-course-container::-webkit-scrollbar-thumb {
    background: var(--ctp-surface1);
    border-radius: 3px;
  }
  .mocha-course-container::-webkit-scrollbar-thumb:hover {
    background: var(--ctp-mauve);
  }

  .mocha-course-container .banner {
    background: linear-gradient(180deg, var(--ctp-mantle) 0%, var(--ctp-crust) 100%) !important;
    border-bottom: 2px solid var(--ctp-surface0) !important;
    box-shadow: 0 4px 12px rgba(17, 17, 27, 0.8) !important;
  }
  .mocha-course-container .banner h1 {
    color: var(--ctp-text) !important;
    text-shadow: 0 2px 4px rgba(17, 17, 27, 0.8) !important;
  }

  .progress-bar-container {
    background: rgba(17, 17, 27, 0.6);
    border: 1px solid var(--ctp-surface0);
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 2rem;
    box-shadow: inset 0 0 12px rgba(17, 17, 27, 0.8);
  }
  .progress-bar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .progress-label {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--ctp-subtext0);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  .progress-percent {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--ctp-mauve);
    font-weight: bold;
    text-shadow: 0 0 8px rgba(203, 166, 247, 0.5);
  }
  .progress-track {
    height: 8px;
    background: var(--ctp-crust);
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--ctp-surface0);
  }
  .progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--ctp-blue) 0%, var(--ctp-mauve) 100%);
    border-radius: 4px;
    transition: width 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    box-shadow: 0 0 8px rgba(203, 166, 247, 0.8);
  }

  .markdown-body h2 {
    font-size: 1.5rem;
    color: var(--ctp-text);
    margin-top: 2.5rem;
    margin-bottom: 1.2rem;
    border-bottom: 2px solid var(--ctp-surface0);
    padding-bottom: 0.5rem;
    position: relative;
  }
  .markdown-body h2::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, var(--ctp-blue) 0%, var(--ctp-mauve) 100%);
    box-shadow: 0 0 6px rgba(203, 166, 247, 0.8);
  }
  .markdown-body h3 {
    font-size: 1.25rem;
    color: var(--ctp-mauve);
    margin-top: 2rem;
    margin-bottom: 0.8rem;
    border: none;
    padding: 0;
    text-shadow: 0 0 6px rgba(203, 166, 247, 0.25);
  }

  .markdown-body ul {
    list-style-type: none;
    padding-left: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .markdown-body ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.8rem;
    line-height: 1.6;
    color: var(--ctp-subtext1);
  }
  .markdown-body ul li::before {
    content: '►';
    position: absolute;
    left: 0;
    color: var(--ctp-mauve);
    font-size: 0.7rem;
    top: 0.2rem;
    text-shadow: 0 0 5px rgba(203, 166, 247, 0.8);
    transition: transform 0.2s ease;
  }
  .markdown-body ul li:hover::before {
    transform: translateX(3px);
  }

  .markdown-body ol {
    list-style: none;
    background: rgba(17, 17, 27, 0.6);
    border: 1px solid var(--ctp-surface0);
    border-radius: 6px;
    padding: 1.2rem;
    margin: 1rem 0 2rem 0;
    box-shadow: inset 0 0 12px rgba(17, 17, 27, 0.8);
  }
  .markdown-body ol li {
    display: flex !important;
    align-items: flex-start;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
    color: var(--ctp-subtext1);
    line-height: 1.5;
    font-size: 0.92rem;
  }
  .markdown-body ol li:last-child {
    margin-bottom: 0;
  }

  .task-checkbox {
    appearance: none;
    -webkit-appearance: none;
    background-color: var(--ctp-crust);
    border: 1px solid var(--ctp-surface0);
    padding: 7px;
    border-radius: 4px;
    display: inline-block;
    position: relative;
    cursor: pointer;
    margin-top: 4px;
    flex-shrink: 0;
    transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .task-checkbox:hover {
    border-color: var(--ctp-surface2);
    box-shadow: 0 0 6px rgba(203, 166, 247, 0.3);
  }
  .task-checkbox:checked {
    background-color: var(--ctp-mauve);
    border-color: var(--ctp-pink);
    box-shadow: 0 0 8px rgba(203, 166, 247, 0.6);
  }
  .task-checkbox:checked::after {
    content: '✔';
    font-size: 10px;
    position: absolute;
    top: -1px;
    left: 2px;
    color: var(--ctp-crust);
  }
  
  .task-text {
    flex-grow: 1;
    transition: color 0.2s ease, text-decoration 0.2s ease;
  }
  .task-completed .task-text {
    color: var(--ctp-surface2) !important;
    text-decoration: line-through;
  }
  .task-completed code {
    color: var(--ctp-surface1) !important;
    border-color: var(--ctp-crust) !important;
    background: transparent !important;
  }

  .markdown-body p strong {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--ctp-blue);
    background: rgba(137, 180, 250, 0.1);
    border: 1px solid rgba(137, 180, 250, 0.25);
    padding: 4px 10px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .markdown-body code {
    background: rgba(49, 50, 68, 0.4) !important;
    border: 1px solid rgba(69, 71, 90, 0.6) !important;
    color: var(--ctp-pink) !important;
    padding: 2px 6px !important;
    border-radius: 4px !important;
    font-family: monospace !important;
    font-size: 0.85rem !important;
  }

  .markdown-body a {
    color: var(--ctp-blue);
    text-decoration: none;
    border-bottom: 1px dashed rgba(137, 180, 250, 0.5);
    padding: 0 2px;
    transition: all 0.2s ease;
  }
  .markdown-body a:hover {
    color: var(--ctp-text);
    background: rgba(137, 180, 250, 0.15);
    border-bottom: 1px solid var(--ctp-mauve);
    text-shadow: 0 0 5px var(--ctp-text);
  }

  .course-banner-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 450px;
    margin-bottom: 2rem;
    border: 2px solid var(--ctp-surface0);
    border-radius: 8px;
    background: var(--ctp-crust);
    box-shadow: 0 4px 8px rgba(17, 17, 27, 0.8), inset 0 0 5px rgba(255,255,255,0.05);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .course-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .course-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--ctp-surface0);
    text-align: center;
  }
  .license-notice {
    font-size: 0.85rem;
    color: var(--ctp-subtext0);
    line-height: 1.5;
    margin: 0;
  }
  .license-notice a {
    color: var(--ctp-subtext1);
    text-decoration: underline;
    font-weight: bold;
    transition: color 0.15s;
  }
  .license-notice a:hover {
    color: var(--ctp-text);
  }
  .course-header {
    background: rgba(24, 24, 37, 0.4);
    border: 1px solid var(--ctp-surface0);
    border-radius: 6px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    box-shadow: inset 0 0 10px rgba(17, 17, 27, 0.6);
  }
  .course-title {
    font-size: 1.8rem;
    color: var(--ctp-text);
    margin-bottom: 0.5rem;
    border: none;
    padding: 0;
  }
  .course-desc {
    color: var(--ctp-subtext1);
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  .course-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .course-date {
    font-family: monospace;
    color: var(--ctp-subtext0);
    font-size: 0.9rem;
  }
  .course-tags {
    display: flex;
    gap: 0.5rem;
  }
  .tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-family: monospace;
    border: 1px solid rgba(203, 166, 247, 0.15);
    background: rgba(203, 166, 247, 0.05);
    color: var(--ctp-mauve);
  }
  .separator {
    border-color: var(--ctp-surface0);
    margin: 2rem 0;
  }
</style>